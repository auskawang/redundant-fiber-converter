# ==============================================================================
# STM32CubeIDE / Eclipse CDT - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Directories & Managed Build Output
# ------------------------------------------------------------------------------
# Default build configuration folders generated by STM32CubeIDE / Eclipse CDT
Debug/
Release/
[Dd]ebug/
[Rr]elease/

# Managed build generated makefiles and lists
makefile
objects.mk
sources.mk
subdir.mk
objects.list

# Intermediate compilation artifacts
*.o
*.obj
*.o.d
*.d
*.a
*.lib

# Compiler diagnostic & profiling outputs
*.su
*.cyclo

# Binary and executable targets
*.elf
*.bin
*.hex
*.srec
*.axf

# Linker memory map & assembly listing files
*.map
*.list
*.lst

# ------------------------------------------------------------------------------
# Eclipse & STM32CubeIDE Metadata & Local Settings
# ------------------------------------------------------------------------------
# Eclipse workspace metadata (created if workspace is set in or near repo root)
.metadata/

# STM32CubeIDE project preferences (contains volatile file/IOC checksums updated on every build)
stm32cubeide.project.prefs
*.project.prefs

# Eclipse Run/Debug launch configurations (contain machine-specific ST-Link serials & local paths)
*.launch
*.jlink

# Eclipse logs & external builders
*.log
.externalToolBuilders/
.loadpath

# ------------------------------------------------------------------------------
# OS-specific files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux / Editor backup files
*~
*.bak
*.tmp
*.swp
*.swo

# ------------------------------------------------------------------------------
# General Editor / IDE configurations
# ------------------------------------------------------------------------------
.vscode/
.idea/
